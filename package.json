{
  "name": "vaelthorn-archive",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lodestar": "npm --prefix lodestar run dev",
    "build": "vite build && npm run build:lodestar",
    "build:lodestar": "npm --prefix lodestar run build -- --outDir ../dist/lodestar --emptyOutDir",
    "preview": "vite preview",
    "postinstall": "npm --prefix lodestar ci"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "svelte": "^5.19.0",
    "vite": "^6.0.11"
  }
}
